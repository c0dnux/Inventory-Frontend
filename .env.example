# Copy to .env and adjust.

# API base path used by the app. In dev this is proxied by Vite to the backend.
VITE_API_URL=/api/v1

# Backend origin the Vite dev server proxies /api to (must match the backend PORT).
VITE_PROXY_TARGET=http://localhost:3000

# Google OAuth client ID to enable "Continue with Google".
# Must match GOOGLE_CLIENT_ID in the backend config.env. Add this app's
# origins (http://localhost:3001 in dev, plus the deployed origin) to the
# "Authorized JavaScript origins" in the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=
